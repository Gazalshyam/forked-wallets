# Copy to .env and fill in. Never commit .env.
# With the defaults below the app runs fully in mock mode (no credentials needed).

APP_BASE_URL=http://localhost:8000
SESSION_SECRET=change-me-to-a-long-random-string
# Any long random string; used to encrypt saved PayPal vault tokens at rest.
TOKEN_ENCRYPTION_KEY=change-me-too
DEMO_MODE=true

# ---- Payments: mock | paypal ----
PAYMENT_PROVIDER=mock
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=your-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-sandbox-client-secret
# Turn on only after scripts/paypal_spike.py shows the step passes.
PAYPAL_VAULT_ENABLED=false
PAYPAL_PAYOUTS_ENABLED=false
PAYPAL_WEBHOOK_ID=
# A second US Business Sandbox account that plays the demo hotel.
DEMO_HOTEL_PAYPAL_EMAIL=hotel-business@example.com

# ---- AI: mock | anthropic | openai | groq ----
LLM_PROVIDER=mock
# Model ID for the chosen provider, e.g. claude-sonnet-5-5, gpt-4o-mini, or openai/gpt-oss-20b (Groq)
LLM_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

WORKER_POLL_SECONDS=1.5
# Seconds task participants have to agree before the owner's authorization is used (E4)
CONSENT_TIMEOUT_SECONDS=300
